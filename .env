# The sheet music scanner (omr/README.md). Leave empty to hide "Scan sheet music".
# Set it to the Cloud Run URL after `npm run deploy:omr`, e.g. https://piano-omr-xxxx-uw.a.run.app
# For a local container (`npm run omr:dev`) put VITE_OMR_URL=http://localhost:8080 in .env.local instead.
VITE_OMR_URL=
