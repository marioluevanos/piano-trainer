{
  "name": "piano-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "import-songs": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/import-songs.ts",
    "upload-songs": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/upload-songs.ts",
    "deploy": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "icons": "pwa-assets-generator",
    "omr:build": "docker build --platform linux/amd64 -t piano-omr omr",
    "omr:dev": "docker run --rm --platform linux/amd64 -p 8080:8080 -e OMR_DEV_NO_AUTH=1 piano-omr",
    "deploy:omr": "gcloud run deploy piano-omr --source omr --project mario-luevanos --region us-west1 --memory 4Gi --cpu 2 --concurrency 1 --max-instances 1 --timeout 900 --allow-unauthenticated --set-env-vars OMR_ALLOWED_EMAILS=marioluevanos@gmail.com"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "opensheetmusicdisplay": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  }
}
